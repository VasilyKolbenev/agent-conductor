{
  "_readme": "PENDING C/API-1 cases; API-0 evaluates them with a test-local relation.",
  "proposal_cases": [
    {
      "name": "valid_declared_dispatch",
      "adapter_capabilities": ["observe", "dispatch", "review"],
      "body": {
        "instance_id": "claude-dev",
        "attempt_id": "attempt-cockpit-001",
        "capability": "dispatch",
        "arguments": {"handoff": "handoff-cockpit-001"},
        "scope": ["src", "tests"],
        "proposed_by": "claude-dev",
        "rationale": "Dispatch the reviewed handoff.",
        "timeout_seconds": 900,
        "adapter_id": "claude-code"
      },
      "expected": {"disposition": "accept", "error_code": null}
    },
    {
      "name": "unknown_top_level_is_not_extra_mutation_surface",
