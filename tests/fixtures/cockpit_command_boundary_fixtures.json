      "body": {
        "instance_id": "claude-dev",
        "attempt_id": "attempt-cockpit-001",
        "capability": "dispatch",
        "arguments": {"handoff": "handoff-cockpit-001"},
        "scope": ["src"],
        "proposed_by": "claude-dev",
        "rationale": "Dispatch the reviewed handoff.",
        "timeout_seconds": 900,
        "debug_override": true
      },
      "expected": {"disposition": "refuse", "error_code": "contract_invalid"}
    },
    {
      "name": "shell_field_is_refused",
