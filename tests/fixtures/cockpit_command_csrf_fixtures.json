          "attempt_id": "attempt-cockpit-001",
          "capability": "dispatch",
          "arguments": { "handoff": "handoff-cockpit-001" },
          "scope": ["src", "tests"],
          "proposed_by": "claude-dev",
          "rationale": "The lane finished its handoff and asks to dispatch implementation.",
          "timeout_seconds": 900,
