          "Origin": "http://127.0.0.1:{port}",
          "Content-Type": "application/json; charset=utf-8",
          "X-Conduct-CSRF": "csrf-current-R7a9pQ2kLm4nX8sV3wZ6cD1fH5jT0bY"
        },
        "csrf_token_source": "current_process",
        "json_body": {
