{
  "schema_version": 1,
  "template_id": "desk-standard",
  "revision": 1,
  "title": "Standard",
  "nodes": [
    {
      "node_id": "analyst",
      "kind": "task",
      "title": "Analyst",
      "purpose": "Read the brief and the materials, then write down the goal, the constraints and how the result will be checked. Answer in the language of the brief.",
      "timeout_seconds": 1800,
      "role_id": "role-analyst",
      "capability": "review",
      "arguments": {
        "work_item_id": "work-001",
        "target_artifact_refs": [
          "artifact-brief",
          "artifact-materials"
        ],
        "result_artifact_ref": "artifact-analyst",
        "review_profile": "spec"
      },
      "resources": []
    },
    {
      "node_id": "do",
      "kind": "task",
      "title": "Doer",
      "purpose": "Carry out the task in the project folder following the instruction and the analysis. Answer in the language of the brief.",
      "timeout_seconds": 1800,
      "role_id": "role-doer",
      "capability": "dispatch",
      "verifier_role_id": "role-checker",
      "arguments": {
        "work_item_id": "work-001",
        "instruction_ref": "instruction-do",
        "profile": "implement",
        "artifact_refs": [
          "artifact-analyst"
        ],
        "output_limit_profile": "normal"
      },
      "resources": [
        {
          "kind": "sandbox",
          "name": "project-root"
        }
      ]
    },
    {
      "node_id": "result",
      "kind": "gate",
      "title": "Decision",
      "gate_id": "gate-result",
      "success_requires": "human_approval",
      "resources": []
    },
    {
      "node_id": "do-fix",
      "kind": "loop",
      "title": "Loop",
      "loop": {
        "bound": 3,
        "back_to": "do"
      },
      "resources": []
    }
  ],
  "edges": [
    {
      "from_node": "analyst",
      "to_node": "do",
      "condition": "on_succeeded"
    },
    {
      "from_node": "do",
      "to_node": "result",
      "condition": "on_succeeded"
    },
    {
      "from_node": "do",
      "to_node": "do-fix",
      "condition": "on_failed"
    }
  ],
  "execution_contract": "bounded-run-v1"
}
